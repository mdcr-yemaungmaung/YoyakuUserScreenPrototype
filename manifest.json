      "icons": [{ "src": "assets/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "My Reservations",
      "short_name": "Bookings",
      "description": "View active table passes and QR codes",
      "url": "/?tab=reservations",
      "icons": [{ "src": "assets/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Lookup Booking",
      "short_name": "Lookup",
      "description": "Find unlinked guest reservation with code",
      "url": "/?tab=login&sub=lookup",
      "icons": [{ "src": "assets/icons/icon-192.svg", "sizes": "192x192" }]
